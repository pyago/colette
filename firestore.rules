rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'paul.yago@gmail.com',
          'kibawaf1990@gmail.com'
        ];
    }

    function isAuthor() {
      return signedIn()
        && resource.data.authorId == request.auth.uid;
    }

    match /posts/{id} {
      allow read: if resource.data.status == 'approved'
        || isAdmin()
        || isAuthor();

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['text', 'image', 'video']
        && request.resource.data.keys().hasAll([
          'authorId',
          'authorName',
          'authorEmail',
          'type',
          'status',
          'createdAt',
          'body'
        ]);

      // Admins may publish their own posts as approved in one write.
      allow create: if isAdmin()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status in ['pending', 'approved'];

      allow update, delete: if isAdmin();
    }
  }
}
